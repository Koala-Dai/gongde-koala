# ── 依赖 ──────────────────────────────────────
node_modules/

# ── 打包产物（由本地 build 或 CI 生成，体积大）──
dist/
out/

# ── 原生模块编译中间产物（node-gyp 生成；通用 .node 已提交进 src/native 供 CI/Windows 使用）──
# 注意：build/ 下有应用图标 icon.icns / icon.png 必须跟踪，只能忽略其余编译产物
build/*
!build/icon.icns
!build/icon.png

# ── 系统 / 编辑器 ──────────────────────────────
.DS_Store
*.log
.vscode/
.idea/

# ── 精灵图源帧（已生成的精灵图在 assets/koala，raw 仅用于重新生成）──
assets/raw/

# ── 本地运行时数据（用户数据在 ~/Library/Application Support）──
*.local
